# Copy to .env and fill in. Never commit the real .env.

# Garmin Connect login (only needed for the FIRST `python sync.py --login`)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password
GARMIN_IS_CN=false

# Anthropic API key for the AI analysis (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Model string - change to one you have access to (e.g. claude-opus-4-8)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Personal baseline used by the analytics
SLEEP_NEED_HOURS=8.0
