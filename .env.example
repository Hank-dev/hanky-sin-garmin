# Copy to .env and fill in. Never commit the real .env.

# Garmin Connect login (only needed for the FIRST `python sync.py --login`)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password
GARMIN_IS_CN=false

# AI runs through Claude Code (`claude -p`) on its login; no API key needed.
# Passed to `claude --model`: an alias (sonnet, opus) or a full model id.
ANTHROPIC_MODEL=sonnet

# Personal baseline used by the analytics
SLEEP_NEED_HOURS=8.0
