"""Streamlit dashboard.  Run with:  streamlit run app.py"""
import streamlit as st
import pandas as pd
import plotly.graph_objects as go
from plotly.subplots import make_subplots

import db
import analysis
import ai
import config

st.set_page_config(page_title="Garmin Coach", layout="wide")

ACCENT = "#1f77b4"
WARN = "#d62728"
GOOD = "#2ca02c"


@st.cache_data(ttl=300)
def load():
    db.init_db()
    daily = analysis.enrich_daily(db.load_daily_df())
    acts = db.load_activities_df()
    daily = analysis.compute_acwr(acts, daily) if not daily.empty else daily
    return daily, acts


daily, acts = load()

st.title("🏃 Garmin Coach")
if daily.empty:
    st.warning("No data yet. Run `python sync.py --login` then `python sync.py --days 90`.")
    st.stop()

# ---- Sidebar ----
with st.sidebar:
    st.header("Window")
    min_d, max_d = daily["date"].min().date(), daily["date"].max().date()
    span = st.slider("Days to show", 7, max(14, (max_d - min_d).days or 14),
                     min(60, (max_d - min_d).days or 14))
    view = daily[daily["date"] >= (daily["date"].max() - pd.Timedelta(days=span))]
    st.caption(f"Data: {min_d} → {max_d}  ({len(daily)} days)")

latest = daily.iloc[-1]

# ---- Top KPIs ----
c1, c2, c3, c4, c5 = st.columns(5)
def metric(col, label, val, fmt="{:.0f}", suffix=""):
    col.metric(label, "—" if pd.isna(val) else (fmt.format(val) + suffix))
metric(c1, "HRV (overnight)", latest.get("hrv_overnight_avg"), "{:.0f}", " ms")
metric(c2, "Resting HR", latest.get("resting_hr"), "{:.0f}", " bpm")
metric(c3, "Sleep", latest.get("sleep_hours"), "{:.1f}", " h")
metric(c4, "Training readiness", latest.get("training_readiness_score"))
metric(c5, "ACWR", latest.get("acwr") if "acwr" in latest else float("nan"), "{:.2f}")

if latest.get("hrv_flag") == "suppressed":
    st.error("⚠️ Overnight HRV is suppressed vs your baseline — a marker of under-recovery, stress, or illness onset.")
elif pd.notna(latest.get("rhr_elevated")) and latest.get("rhr_elevated"):
    st.warning("⚠️ Resting HR is elevated >5% above your 28-day baseline.")

tab_rec, tab_train, tab_ai, tab_data = st.tabs(
    ["Recovery", "Training", "AI analysis", "Raw table"])

# ---------- RECOVERY ----------
with tab_rec:
    fig = make_subplots(
        rows=3, cols=1, shared_xaxes=True, vertical_spacing=0.06,
        subplot_titles=("Overnight HRV vs baseline band", "Resting HR (with 7d & 28d)", "Sleep hours"))
    # HRV + baseline band
    if view["hrv_baseline_low"].notna().any():
        fig.add_trace(go.Scatter(x=view["date"], y=view["hrv_baseline_high"],
                      line=dict(width=0), showlegend=False, hoverinfo="skip"), 1, 1)
        fig.add_trace(go.Scatter(x=view["date"], y=view["hrv_baseline_low"], fill="tonexty",
                      fillcolor="rgba(44,160,44,0.12)", line=dict(width=0),
                      name="HRV baseline band"), 1, 1)
    fig.add_trace(go.Scatter(x=view["date"], y=view["hrv_overnight_avg"],
                  mode="lines+markers", name="HRV", line=dict(color=ACCENT)), 1, 1)
    fig.add_trace(go.Scatter(x=view["date"], y=view["hrv_7d"], name="HRV 7d",
                  line=dict(color=ACCENT, dash="dot")), 1, 1)
    # RHR
    fig.add_trace(go.Scatter(x=view["date"], y=view["resting_hr"], name="RHR",
                  mode="lines+markers", line=dict(color=WARN)), 2, 1)
    fig.add_trace(go.Scatter(x=view["date"], y=view["rhr_28d"], name="RHR 28d",
                  line=dict(color=WARN, dash="dot")), 2, 1)
    # Sleep
    colors = [WARN if (config.SLEEP_NEED_HOURS - h) > 1 else GOOD
              for h in view["sleep_hours"].fillna(0)]
    fig.add_trace(go.Bar(x=view["date"], y=view["sleep_hours"], name="Sleep h",
                  marker_color=colors), 3, 1)
    fig.add_hline(y=config.SLEEP_NEED_HOURS, line_dash="dash", row=3, col=1)
    fig.update_layout(height=720, margin=dict(t=40, b=20), legend_orientation="h")
    st.plotly_chart(fig, width='stretch')

    cc1, cc2 = st.columns(2)
    with cc1:
        st.subheader("Sleep composition (last 14 nights)")
        s = view.tail(14)
        comp = go.Figure()
        for col, name, c in [("deep_seconds", "Deep", "#08306b"),
                             ("rem_seconds", "REM", "#2171b5"),
                             ("light_seconds", "Light", "#6baed6"),
                             ("awake_seconds", "Awake", "#bdbdbd")]:
            comp.add_trace(go.Bar(x=s["date"], y=s[col] / 3600.0, name=name, marker_color=c))
        comp.update_layout(barmode="stack", height=320, yaxis_title="hours",
                           margin=dict(t=10), legend_orientation="h")
        st.plotly_chart(comp, width='stretch')
    with cc2:
        st.subheader("Body Battery & stress")
        bb = go.Figure()
        bb.add_trace(go.Scatter(x=view["date"], y=view["body_battery_high"],
                     name="BB high", line=dict(color=GOOD)))
        bb.add_trace(go.Scatter(x=view["date"], y=view["body_battery_low"],
                     name="BB low", line=dict(color="#ff7f0e")))
        bb.add_trace(go.Scatter(x=view["date"], y=view["stress_avg"],
                     name="Avg stress", line=dict(color=WARN, dash="dot")))
        bb.update_layout(height=320, margin=dict(t=10), legend_orientation="h")
        st.plotly_chart(bb, width='stretch')

# ---------- TRAINING ----------
with tab_train:
    if "acwr" in view:
        fig2 = make_subplots(specs=[[{"secondary_y": True}]])
        fig2.add_trace(go.Bar(x=view["date"], y=view["acute_load"], name="Acute load (7d)",
                       marker_color="rgba(31,119,180,0.5)"), secondary_y=False)
        fig2.add_trace(go.Scatter(x=view["date"], y=view["chronic_load"], name="Chronic (wkly avg)",
                       line=dict(color="#333")), secondary_y=False)
        fig2.add_trace(go.Scatter(x=view["date"], y=view["acwr"], name="ACWR",
                       line=dict(color=WARN, width=3)), secondary_y=True)
        fig2.add_hrect(y0=0.8, y1=1.3, line_width=0, fillcolor="rgba(44,160,44,0.10)",
                       secondary_y=True)
        fig2.update_yaxes(title_text="Training load", secondary_y=False)
        fig2.update_yaxes(title_text="ACWR", secondary_y=True, range=[0, 2.5])
        fig2.update_layout(height=420, margin=dict(t=20), legend_orientation="h",
                           title="Acute:Chronic Workload Ratio (green = ~0.8–1.3 sweet spot)")
        st.plotly_chart(fig2, width='stretch')
    if "vo2max" in view and view["vo2max"].notna().any():
        st.plotly_chart(go.Figure(go.Scatter(x=view["date"], y=view["vo2max"],
                        mode="lines+markers", line=dict(color=ACCENT)))
                        .update_layout(title="VO₂max estimate", height=280,
                                       margin=dict(t=40)), width='stretch')
    st.subheader("Recent activities")
    if not acts.empty:
        t = acts.tail(25).sort_values("date", ascending=False).copy()
        t["duration_min"] = (t["duration_s"] / 60).round(1)
        t["distance_km"] = (t["distance_m"] / 1000).round(2)
        st.dataframe(t[["date", "type", "name", "duration_min", "distance_km",
                        "avg_hr", "training_load", "aerobic_te"]],
                     width='stretch', hide_index=True)
    else:
        st.info("No activities stored.")

# ---------- AI ----------
with tab_ai:
    st.caption(f"Model: `{config.ANTHROPIC_MODEL}` — change via ANTHROPIC_MODEL in .env")
    if st.button("Analyse my recent data", type="primary"):
        with st.spinner("Asking Claude…"):
            summ = analysis.summarize(daily, acts, lookback=14)
            try:
                st.markdown(ai.analyze(summ))
            except Exception as e:
                st.error(f"AI call failed: {e}")
        with st.expander("Data sent to the model"):
            st.json(summ)

# ---------- RAW ----------
with tab_data:
    st.dataframe(daily.sort_values("date", ascending=False),
                 width='stretch', hide_index=True)
